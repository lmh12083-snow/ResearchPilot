DATABASE_URL=mysql+pymysql://user:password@localhost/researchpilot
JWT_SECRET_KEY=your-secret-key-change-in-production
UPLOAD_PATH=./uploads
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# LLM — required for chat / analysis / review / eval features
# Please use your own API key. The repository does not include any key.
DEEPSEEK_API_KEY=your-deepseek-api-key
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embedding model (local sentence-transformer, downloaded on first use)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Web search
WEB_SEARCH_PROVIDER=duckduckgo   # duckduckgo | bing
BING_SEARCH_API_KEY=

# Docker compose only — host HuggingFace cache mounted into the backend container
HF_CACHE_DIR=
